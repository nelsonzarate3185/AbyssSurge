# ─── Supabase ───────────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_PROJECT_REF=ocmroiupftpbsukuqvyu
SUPABASE_URL=https://ocmroiupftpbsukuqvyu.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# SOLO servidor / Edge Functions. Nunca en el cliente Unity.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase local (valores por defecto de `supabase start`)
SUPABASE_LOCAL_URL=http://127.0.0.1:54321
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── Juego ──────────────────────────────────────────────────
# Minutos que una sesión de mazmorra puede quedar abierta antes de vencer.
DUNGEON_SESSION_TTL_MINUTES=30

# ─── MercadoPago Paraguay (pendiente de integrar) ───────────
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=
# MERCADOPAGO_WEBHOOK_SECRET=

# ─── Build ──────────────────────────────────────────────────
UNITY_VERSION=2022.3.62f1
BUILD_ENV=development
