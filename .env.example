# ─── Supabase ───────────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_PROJECT_REF=ocmroiupftpbsukuqvyu
SUPABASE_URL=https://ocmroiupftpbsukuqvyu.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# SOLO servidor / Edge Functions. Nunca en el cliente Unity.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase local (valores por defecto de `supabase start`)
SUPABASE_LOCAL_URL=http://127.0.0.1:54321
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── Juego ──────────────────────────────────────────────────
# Minutos que una sesión de mazmorra puede quedar abierta antes de vencer.
DUNGEON_SESSION_TTL_MINUTES=30

# ─── MercadoPago Paraguay ───────────────────────────────────
# Panel de MercadoPago → Tus integraciones → tu aplicación → Credenciales.
# Usar las de PRUEBA hasta que el flujo esté verificado end-to-end.
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADOPAGO_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000

# Credenciales → Webhooks → "Clave secreta". NO es el access token.
# Sin esto el webhook rechaza todas las notificaciones.
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret

# Deep link al que vuelve el usuario después de pagar.
PAYMENT_RETURN_URL=abysssurge://payment-return

# ─── Build ──────────────────────────────────────────────────
UNITY_VERSION=2022.3.62f1
BUILD_ENV=development
