# ─── Supabase ───────────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_PROJECT_REF=your-project-ref

# SOLO servidor / Edge Functions. Nunca en el cliente Unity.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase local (valores por defecto de `supabase start`)
SUPABASE_LOCAL_URL=http://127.0.0.1:54321
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── Juego ──────────────────────────────────────────────────
# Semilla base de la run diaria. Debe coincidir cliente y servidor.
DAILY_SEED_SALT=change-me

# Ventana de tolerancia (segundos) para validar timestamps de run
RUN_CLOCK_SKEW_SECONDS=120

# ─── Build ──────────────────────────────────────────────────
UNITY_VERSION=2022.3.62f1
BUILD_ENV=development
